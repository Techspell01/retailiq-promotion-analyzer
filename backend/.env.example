# Copy this file to .env and fill in what you need. Everything is optional:
# with no .env the app runs on SQLite, embedded Qdrant and local embeddings,
# and the chat answers straight from the KPI tools (no LLM).

# ── LLM for the LangGraph agent (any OpenAI-compatible endpoint) ────────────
# Cerebras (the original setup; free key at https://cloud.cerebras.ai)
LLM_API_KEY=
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=gpt-oss-120b

# Groq (free key at https://console.groq.com)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Google Gemini (free key at https://aistudio.google.com/apikey). Uses Google's
# own client, which Gemini 3 needs for tool calling. Free-tier quotas are small
# and per model (gemini-3.5-flash: about 5 a minute and 20 a day), so use
# flash-lite as the main model; it also needs fewer calls per answer.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.1-flash-lite
# LLM_FALLBACK_MODEL=gemini-3.5-flash

# Optional for any provider: a second model tried when the main one fails.
# LLM_FALLBACK_MODEL=

# Ollama running locally (no key needed, but LLM_API_KEY must be non-empty)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b

# ── Database ──────────────────────────────────────────────────────────────
# Defaults to a local SQLite file (retailiq.db). For PostgreSQL:
# DB_CONN=postgresql://retailiq:retailiq@localhost:5432/retailiq

# ── Vector store and embeddings ───────────────────────────────────────────
# Defaults to embedded Qdrant in .qdrant/. For a Qdrant server or Qdrant Cloud:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# Dense embeddings default to fastembed's BAAI/bge-small-en-v1.5 on the CPU.
# To use a text-embeddings-inference server instead (the original setup):
# EMBEDDING_SERVER_URL=http://127.0.0.1:8080

# ── Source system the ETL pipeline pulls from ─────────────────────────────
SOURCE_API_URL=http://127.0.0.1:3000/api/v1

# ── App ───────────────────────────────────────────────────────────────────
DEMO_USERNAME=admin
DEMO_PASSWORD=admin123
JWT_SECRET_KEY=change-me
